DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hackathon
# LLM via the OpenAI SDK. LLM_BASE_URL can be any OpenAI-compatible endpoint
# (leave empty for OpenAI itself). LLM_MODEL is the plain model name.
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
AGENT_ACCESS_KEY=
# Hermes gateway base URL ends in /v1. Use distinct gateway and dashboard keys.
HERMES_BASE_URL=
HERMES_API_KEY=
HERMES_TRIGGER_KEY=
DATA_DIR=~/Desktop/soony-data
# Soony portal API: paste the team token from the portal Settings page
PORTAL_TOKEN=
# Optional direct sync. The token is private; never commit backend/.env.
SOONY_PORTAL_URL=https://start-hack-portal-cxh3crbdaef2f8gt.westeurope-01.azurewebsites.net
SOONY_PORTAL_TOKEN=
SOONY_PORTAL_TOKEN_HEADER=Authorization
SOONY_PORTAL_TOKEN_PREFIX=Bearer
# If portal auth expects a raw team token header, set PREFIX to an empty value.
