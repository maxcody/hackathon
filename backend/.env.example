DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hackathon
DATA_DIR=~/Desktop/soony-data
# Soony portal API: its base URL, and the team token from the portal Settings page
PORTAL_URL=
PORTAL_TOKEN=
# Dashboard agent chat: "codex" (default, uses the Codex CLI and its MCP tools)
# or "openai" (direct LLM_MODEL call, no tools)
CHAT_ENGINE=codex
# Optional full path to codex.exe when the backend cannot find it on PATH.
CODEX_CLI_PATH=
CODEX_MODEL=
CODEX_REASONING_EFFORT=low
CODEX_TIMEOUT_SECONDS=1200
# Only for CHAT_ENGINE=openai; LLM_BASE_URL can be any OpenAI-compatible endpoint
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
# Email MCP tool (scripts/email_mcp.py): SMTP_USER is the sender address.
# BREVO_API_KEY sends over HTTPS (sender must be verified in Brevo); without it,
# Gmail SMTP with SMTP_APP_PASSWORD is used (often blocked on company networks).
SMTP_USER=
BREVO_API_KEY=
SMTP_APP_PASSWORD=
# smtp = send through Gmail (From stays SMTP_USER, so replies reach the Inbox);
# gmail_script = same Gmail account through the Apps Script web app over HTTPS
# (for networks that block SMTP; needs GMAIL_SCRIPT_URL/_TOKEN and doPost deployed);
# brevo = send through Brevo, which rewrites a @gmail.com sender to an
# @…brevosend.com address that cannot receive replies. Empty: brevo if BREVO_API_KEY is set.
MAIL_TRANSPORT=
# Comma-separated recipient domains the agents may email (the sender is always allowed)
EMAIL_ALLOWED_DOMAINS=suppliers.juliansibbing.de,gmx.de,gmx.net,gmx.com
# Inbox tab, received mail: Apps Script web app from backend/scripts/gmail_inbox.gs
GMAIL_SCRIPT_URL=
GMAIL_SCRIPT_TOKEN=
# Seconds the Inbox reuses Brevo statuses and received Gmail before refetching (Refresh skips it)
INBOX_CACHE_SECONDS=60
